# ===== قاعدة البيانات (PostgreSQL) =====
# مثال محلي: postgresql://postgres:postgres@localhost:5432/hammoudi
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# الرابط العام للموقع (يُستخدم في الروابط وخريطة الموقع وروابط واتساب)
NEXT_PUBLIC_SITE_URL="https://example.com"

# ===== إنشاء أول مدير (لمرة واحدة) =====
# الخيار 1: npm run admin:create  (يقرأ هذه القيم أو يسألك عنها)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""
# الخيار 2: صفحة /admin/setup — تعمل فقط إذا لم يوجد أي مدير، وتتطلب هذا الرمز
# ضع قيمة عشوائية طويلة (32 حرفاً فأكثر) ثم احذفها بعد إنشاء المدير
SETUP_TOKEN=""
